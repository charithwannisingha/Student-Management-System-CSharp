<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
  </startup>

  <!-- =====================================================================
       Database Connection String
       =====================================================================
       Update the "connectionString" value below to match your SQL Server
       instance and authentication method before building/running.

       Examples:
         LocalDB:
           Server=(localdb)\MSSQLLocalDB;Database=Student;Integrated Security=True;

         SQL Server Express (default instance name):
           Server=.\SQLEXPRESS;Database=Student;Integrated Security=True;

         SQL Server with Windows Authentication (localhost):
           Server=localhost;Database=Student;Integrated Security=True;

         SQL Server with SQL Authentication:
           Server=localhost;Database=Student;User Id=sa;Password=YourPassword;
       ===================================================================== -->
  <connectionStrings>
    <add name="StudentDB"
         connectionString="Server=localhost;Database=Student;Integrated Security=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
